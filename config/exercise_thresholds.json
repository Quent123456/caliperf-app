{
  "version": "1.1",
  "metadata": {
    "description": "Seuils biomécaniques tolérants et réalistes pour Callisthénie & Street Lifting (CaliPerf)",
    "updated_at": "2026-11-23"
  },
  "signal_filtering": {
    "butterworth_order": 4,
    "cutoff_frequency_hz": 3.5,
    "min_frames_for_butterworth": 12
  },
  "exercises": {
    "full_planche": {
      "display_name": "Full Planche",
      "type": "isometric",
      "primary_camera_angles": ["profile", "three_quarter"],
      "angles": {
        "elbow": {
          "min": 140.0,
          "ideal": 180.0,
          "description": "Verrouillage des coudes (bras tendus)"
        },
        "body_alignment": {
          "min": 130.0,
          "max": 195.0,
          "ideal": 175.0,
          "description": "Alignement épaule-hanche-cheville"
        },
        "body_horizontal_tilt": {
          "min": -35.0,
          "max": 35.0,
          "ideal": 0.0,
          "description": "Inclinaison du corps / horizontale (0° = parallèle)"
        },
        "shoulder_lean": {
          "min": 25.0,
          "max": 85.0,
          "ideal": 50.0,
          "description": "Avancement des épaules"
        }
      },
      "stability": {
        "max_hip_vertical_velocity": 0.15,
        "min_hold_duration_sec": 0.4
      }
    },
    "straddle_planche": {
      "display_name": "Straddle Planche",
      "type": "isometric",
      "primary_camera_angles": ["profile", "three_quarter", "front"],
      "angles": {
        "elbow": {
          "min": 140.0,
          "ideal": 180.0,
          "description": "Verrouillage des coudes"
        },
        "body_alignment": {
          "min": 125.0,
          "max": 195.0,
          "ideal": 170.0,
          "description": "Alignement épaule-bassin"
        },
        "body_horizontal_tilt": {
          "min": -35.0,
          "max": 35.0,
          "ideal": 0.0,
          "description": "Inclinaison du tronc"
        }
      },
      "stability": {
        "max_hip_vertical_velocity": 0.15,
        "min_hold_duration_sec": 0.4
      }
    },
    "maltese": {
      "display_name": "Maltese (Hirondelle)",
      "type": "isometric",
      "primary_camera_angles": ["profile", "front", "three_quarter"],
      "angles": {
        "elbow": {
          "min": 140.0,
          "ideal": 180.0,
          "description": "Verrouillage des coudes"
        },
        "body_alignment": {
          "min": 130.0,
          "max": 195.0,
          "ideal": 175.0,
          "description": "Alignement corps complet"
        },
        "body_horizontal_tilt": {
          "min": -35.0,
          "max": 35.0,
          "ideal": 0.0,
          "description": "Parallélisme avec le sol"
        },
        "arm_abduction": {
          "min": 30.0,
          "max": 90.0,
          "ideal": 55.0,
          "description": "Écartement des bras par rapport au tronc"
        }
      },
      "stability": {
        "max_hip_vertical_velocity": 0.15,
        "min_hold_duration_sec": 0.4
      }
    },
    "front_lever": {
      "display_name": "Front Lever",
      "type": "isometric",
      "primary_camera_angles": ["profile", "three_quarter"],
      "angles": {
        "elbow": {
          "min": 140.0,
          "ideal": 180.0,
          "description": "Bras tendus sous la barre"
        },
        "body_alignment": {
          "min": 130.0,
          "max": 195.0,
          "ideal": 175.0,
          "description": "Alignement épaule-hanche-pieds"
        },
        "body_horizontal_tilt": {
          "min": -35.0,
          "max": 35.0,
          "ideal": 0.0,
          "description": "Alignement horizontal du corps"
        },
        "shoulder_trunk_angle": {
          "min": 25.0,
          "max": 75.0,
          "ideal": 45.0,
          "description": "Angle d'ouverture bras/buste"
        }
      },
      "stability": {
        "max_hip_vertical_velocity": 0.15,
        "min_hold_duration_sec": 0.4
      }
    },
    "pull_ups": {
      "display_name": "Tractions",
      "type": "dynamic",
      "primary_camera_angles": ["front", "profile", "three_quarter"],
      "key_joint": "elbow",
      "min_amplitude_deg": 25.0,
      "phases": {
        "lockout_bottom": {
          "elbow_min": 145.0,
          "description": "Suspension basse"
        },
        "inflection_top": {
          "elbow_max": 115.0,
          "description": "Flexion vers le haut"
        }
      },
      "timing": {
        "min_rep_duration_sec": 0.4,
        "max_rep_duration_sec": 9.0,
        "lockout_pause_threshold_sec": 0.5
      }
    },
    "push_ups": {
      "display_name": "Pompes",
      "type": "dynamic",
      "primary_camera_angles": ["profile", "three_quarter"],
      "key_joint": "elbow",
      "min_amplitude_deg": 20.0,
      "phases": {
        "lockout_top": {
          "elbow_min": 145.0,
          "body_alignment_min": 120.0,
          "description": "Bras en extension haute"
        },
        "inflection_bottom": {
          "elbow_max": 120.0,
          "body_alignment_min": 115.0,
          "description": "Flexion vers le sol"
        }
      },
      "timing": {
        "min_rep_duration_sec": 0.4,
        "max_rep_duration_sec": 8.0,
        "lockout_pause_threshold_sec": 0.5
      }
    },
    "planche_push_ups": {
      "display_name": "Planche Push-ups",
      "type": "dynamic",
      "primary_camera_angles": ["profile", "three_quarter"],
      "key_joint": "elbow",
      "min_amplitude_deg": 20.0,
      "phases": {
        "lockout_top": {
          "elbow_min": 145.0,
          "body_horizontal_tilt_max": 35.0,
          "body_alignment_min": 125.0,
          "description": "Position haute en planche"
        },
        "inflection_bottom": {
          "elbow_max": 125.0,
          "body_horizontal_tilt_max": 40.0,
          "body_alignment_min": 120.0,
          "description": "Flexion des coudes"
        }
      },
      "timing": {
        "min_rep_duration_sec": 0.4,
        "max_rep_duration_sec": 9.0,
        "lockout_pause_threshold_sec": 0.5
      }
    }
  }
